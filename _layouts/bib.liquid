---
---

{% if entry.abbr %}
  <div class="row">
    <div class="col-sm-2 abbr">
      <abbr class="badge">{{ entry.abbr }}</abbr>
    </div>
    <div id="{{ entry.key }}" class="col-sm-8">
{% else %}
  <div class="row">
    <div id="{{ entry.key }}" class="col-sm-10 offset-sm-2">
{% endif %}
      <div class="title">{{ entry.title }}</div>
      <div class="author">
        {%- assign author_count = entry.author_array | size -%}
        {%- for author in entry.author_array -%}
          {%- assign author_last_name = author.last | regex_replace: '[*∗†‡§¶‖&^]', '' -%}
          {%- assign author_last_html = author.last | regex_replace: '([*∗†‡§¶‖&^]+)', '\1' -%}
          {%- assign author_is_self = false -%}
          {%- if site.scholar.last_name contains author_last_name and site.scholar.first_name contains author.first -%}
            {%- assign author_is_self = true -%}
          {%- endif -%}
          {%- if forloop.first == false -%}
            {%- if forloop.last -%}
              {%- if author_count > 2 -%}, {% else %} {% endif -%}and
            {%- else -%}
              ,
            {%- endif -%}
          {%- endif -%}
          {% if author_is_self %}<em>{{ author.first }} {{ author_last_html }}</em>{% else %}{{ author.first }} {{ author_last_html }}{% endif %}
        {%- endfor -%}
      </div>

      {% assign proceedings = 'inproceedings,incollection' | split: ',' %}
      {% assign thesis = 'thesis,mastersthesis,phdthesis' | split: ',' %}
      {% if entry.type == 'article' %}
        {% assign entrytype = entry.journal %}
      {% elsif proceedings contains entry.type %}
        {% assign entrytype = entry.booktitle | prepend: 'In ' %}
      {% elsif thesis contains entry.type %}
        {% assign entrytype = entry.school %}
      {% else %}
        {% assign entrytype = '' %}
      {% endif %}
      <div class="periodical">
        {% if entrytype and entrytype != '' %}<em>{{ entrytype }}</em>{% if entry.year %}, {% endif %}{% endif %}{% if entry.year %}{{ entry.year }}{% endif %}
      </div>
      {% if entry.note %}
        <div class="periodical">{{ entry.note }}</div>
      {% endif %}

      <div class="links">
        {% if entry.paper %}
          <a class="btn btn-sm z-depth-0" href="{{ entry.paper }}" target="_blank" rel="noopener noreferrer">Paper</a>
        {% endif %}
        {% if entry.doi %}
          <a class="btn btn-sm z-depth-0" href="https://doi.org/{{ entry.doi }}" target="_blank" rel="noopener noreferrer">DOI</a>
        {% endif %}
        {% if entry.arxiv %}
          <a class="btn btn-sm z-depth-0" href="https://arxiv.org/abs/{{ entry.arxiv }}" target="_blank" rel="noopener noreferrer">arXiv</a>
        {% endif %}
        {% if entry.bibtex_show %}
          <a class="bibtex btn btn-sm z-depth-0" role="button">Bib</a>
        {% endif %}
        {% if entry.code %}
          <a class="btn btn-sm z-depth-0" href="{{ entry.code }}" target="_blank" rel="noopener noreferrer">Code</a>
        {% endif %}
      </div>

      {% if entry.bibtex_show %}
        <div class="bibtex hidden">
          {% highlight bibtex %}
{{- entry.bibtex | hideCustomBibtex -}}
          {% endhighlight %}
        </div>
      {% endif %}
    </div>
  </div>
